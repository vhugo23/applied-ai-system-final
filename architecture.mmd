flowchart TD
    subgraph INPUT
        P["User profile<br/>fav genre and mood<br/>secondary genres and moods<br/>targets: energy, valence,<br/>danceability, acousticness, tempo"]
        C["data/songs.csv<br/>18 songs"]
    end

    subgraph PROCESS["PROCESS: loop over every song"]
        L1["1. Load next row<br/>into song dict<br/>numeric fields to float"]

        subgraph SCORING["SCORING RULE: one song + profile = one score"]
            G["Genre<br/>2.0 exact, 1.0 secondary, 0 else"]
            M["Mood<br/>1.0 exact, 0.5 secondary, 0 else"]
            E["Energy similarity<br/>weight 2.0"]
            N["Valence, danceability,<br/>acousticness similarity<br/>weight 0.5 each"]
            T["Tempo similarity, weight 0.5<br/>1 - abs of bpm diff / 160"]
            S["Total score, max 7.0<br/>plus per-feature breakdown"]
            G --> S
            M --> S
            E --> S
            N --> S
            T --> S
        end

        A["3. Append song, score,<br/>breakdown to results list"]
        D{"More songs<br/>in CSV?"}

        L1 --> G
        L1 --> M
        L1 --> E
        L1 --> N
        L1 --> T
        S --> A
        A --> D
        D -- "yes: next song" --> L1
    end

    subgraph OUTPUT
        subgraph RANKING["RANKING RULE: scored list = ordered list"]
            R1["Sort by score, highest first"]
            R2["Tie-break by title A-Z"]
            R3["Keep top K"]
            R1 --> R2 --> R3
        end
        O["Top K recommendations<br/>title, artist, score<br/>short explanation from breakdown"]
        R3 --> O
    end

    C --> L1
    P --> G
    P --> M
    P --> E
    P --> N
    P --> T
    D -- "no: all scored" --> R1
